# Environment configuration for the Decision Intelligence Platform
# Copy to .env and customize for your deployment.

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Logging
LOG_LEVEL=INFO

# Models
DEFAULT_RECOMMENDATION_MODEL=two_step
DEFAULT_FORECAST_MODEL=historical_average

# Simulation (demo mode)
DEMO_MODE=sample
DEMO_FLEET_SIZE=100
DEMO_SEED=42

# Source labeling
# All outputs from this platform are simulation/historical replay based
# unless connected to real-time data.
DATA_SOURCE=historical_replay
